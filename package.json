{
  "name": "rubber-duck-ui",
  "version": "0.1.0",
  "description": "A reusable design system to keep UI consistent across projects.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "scripts": {
    "example": "yarn prepare && yarn workspace rubber-duck-ui-example",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest",
    "release": "release-it --only-version",
    "setup:aiworkers": "bash node_modules/@salve-software/ai-workers/scripts/setup.sh"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Salve-Software/RubberDuckUI.git"
  },
  "author": "eumaninho54 <angelo.omarzinho@outlook.com> (https://github.com/eumaninho54)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Salve-Software/RubberDuckUI/issues"
  },
  "homepage": "https://github.com/Salve-Software/RubberDuckUI#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@salve-software/ai-workers": "github:Salve-Software/AIWorkers",
    "lucide-react-native": "^0.577.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/compat": "^1.3.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/eslint-config": "0.83.0",
    "@release-it/conventional-changelog": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.12",
    "commitlint": "^19.8.1",
    "del-cli": "^6.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "lefthook": "^2.0.3",
    "lottie-react-native": "^7.3.6",
    "prettier": "^2.8.8",
    "react": "19.2.0",
    "react-content-loader": "^7.1.2",
    "react-native": "0.83.2",
    "react-native-builder-bob": "^0.40.18",
    "react-native-reanimated": "^4.2.2",
    "react-native-svg": "^15.15.3",
    "release-it": "^19.0.4",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "lottie-react-native": "*",
    "react": "*",
    "react-content-loader": "*",
    "react-native": "*",
    "react-native-reanimated": ">=4.0.0",
    "react-native-svg": "*",
    "react-native-worklets": ">=0.4.0"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "create-react-native-library": {
    "type": "library",
    "languages": "js",
    "tools": [
      "eslint",
      "jest",
      "lefthook",
      "release-it"
    ],
    "version": "0.57.2"
  }
}
